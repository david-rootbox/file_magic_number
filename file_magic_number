#!/usr/bin/env bash
# Public entry point. The internal probe and terminal/container engine are local.
set -u
for dependency in python3 file bash readlink dirname timeout od tr stat; do
    command -v "$dependency" >/dev/null 2>&1 || {
        printf 'Error: falta %s. En Arch: sudo pacman -S --needed bash python file coreutils\n' "$dependency" >&2
        exit 2
    }
done
script_path=$(readlink -f -- "${BASH_SOURCE[0]}") || exit 2
project_dir=$(dirname -- "$script_path")
[[ -r "$project_dir/lib/terminal_scan.py" ]] || {
    printf 'Error: falta lib/terminal_scan.py. Actualiza o clona el repositorio completo.\n' >&2
    exit 2
}
exec python3 -I "$project_dir/lib/terminal_scan.py" "$@"
