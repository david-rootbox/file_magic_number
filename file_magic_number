#!/usr/bin/env bash
# Identifica archivos por contenido con libmagic y firmas de cabecera.
# Dependencias: Bash, file (libmagic), od y tr. No necesita Internet.
# Referencia de file: https://github.com/file/file/blob/master/doc/file.man
# Firmas: https://www.garykessler.net/library/file_sigs_GCK_latest.html
# Una firma reconocida no valida todo el archivo ni determina su seguridad.

set -u
set -o pipefail
export LC_ALL=C

usage() {
    cat <<EOF
Uso: ${0##*/} [-v|--verbose] [--] ARCHIVO

Identifica el contenido sin confiar en la extensión del nombre.

  -v, --verbose  Muestra MIME, descripción y los primeros 32 bytes.
  -h, --help     Muestra esta ayuda.
  --             Termina las opciones; permite nombres que empiezan por '-'.

Ejemplos:
  ./${0##*/} imagen.php
  ./${0##*/} --verbose "archivo con espacios.bin"
  ./${0##*/} -- -archivo

Salida: 0 = formato o firma reconocidos; 1 = desconocido o vacío;
        2 = error de uso, dependencia o lectura.

La detección es orientativa: una firma de cabecera no valida la estructura
completa. Algunos formatos comparten firmas o no tienen una firma única.
EOF
}

fail() {
    printf 'Error: %s\n' "$*" >&2
    exit 2
}

verbose=false
while (( $# > 0 )); do
    case "$1" in
        -v|--verbose) verbose=true; shift ;;
        -h|--help) usage; exit 0 ;;
        --) shift; break ;;
        -*) fail "Opción desconocida: $1. Usa --help o -- antes del nombre." ;;
        *) break ;;
    esac
done

if (( $# != 1 )); then
    usage >&2
    exit 2
fi

for dependency in file od tr; do
    command -v "$dependency" >/dev/null 2>&1 ||
        fail "Falta '$dependency'. En Arch: sudo pacman -S file coreutils"
done

# El prefijo impide que '-' se interprete como entrada estándar de file.
path=$1
[[ "$path" = /* ]] || path="./$path"
[[ -f "$path" ]] || fail 'La ruta no es un archivo regular accesible.'
[[ -r "$path" ]] || fail 'No tienes permiso para leer el archivo.'
if [[ ! -s "$path" ]]; then
    printf 'El archivo está vacío; no tiene una firma identificable.\n'
    exit 1
fi

# -L sigue enlaces simbólicos; -E hace que los errores de lectura sean errores.
mime=$(file -b -L -E --mime-type -- "$path") || fail 'No se pudo leer el MIME.'
description=$(file -b -L -E -- "$path") || fail 'No se pudo analizar el archivo.'
magic_hex=$(od -An -v -tx1 -N 32 -- "$path" | tr -d '[:space:]') ||
    fail 'No se pudieron leer los primeros bytes.'

extension=''
type_name=''
method='libmagic: firmas y otras comprobaciones del contenido'

# Nombres legibles para formatos frecuentes. La detección la realiza libmagic.
case "$mime" in
    image/png) extension=png; type_name='imagen PNG' ;;
    image/jpeg) extension=jpg; type_name='imagen JPEG' ;;
    image/gif) extension=gif; type_name='imagen GIF' ;;
    image/webp) extension=webp; type_name='imagen WebP' ;;
    image/bmp|image/x-ms-bmp) extension=bmp; type_name='imagen BMP' ;;
    image/tiff) extension=tiff; type_name='imagen TIFF' ;;
    image/svg+xml) extension=svg; type_name='imagen SVG' ;;
    image/avif) extension=avif; type_name='imagen AVIF' ;;
    image/heic) extension=heic; type_name='imagen HEIC' ;;
    image/heif) extension=heif; type_name='imagen HEIF' ;;
    image/vnd.microsoft.icon|image/x-icon) extension=ico; type_name='icono ICO' ;;
    application/pdf) extension=pdf; type_name='documento PDF' ;;
    application/zip|application/x-zip*) extension=zip; type_name='contenedor ZIP' ;;
    application/gzip|application/x-gzip) extension=gz; type_name='archivo comprimido GZIP' ;;
    application/x-bzip2) extension=bz2; type_name='archivo comprimido BZIP2' ;;
    application/x-xz) extension=xz; type_name='archivo comprimido XZ' ;;
    application/x-7z-compressed) extension=7z; type_name='archivo comprimido 7-Zip' ;;
    application/x-rar*|application/vnd.rar) extension=rar; type_name='archivo comprimido RAR' ;;
    application/x-tar) extension=tar; type_name='contenedor TAR' ;;
    application/x-sqlite3|application/vnd.sqlite3) extension=sqlite; type_name='base de datos SQLite' ;;
    application/x-executable|application/x-pie-executable) extension=elf; type_name='ejecutable ELF' ;;
    application/x-sharedlib) extension=so; type_name='objeto compartido ELF' ;;
    application/x-dosexec|application/vnd.microsoft.portable-executable)
        extension=exe; type_name='binario DOS/Windows (puede ser EXE o DLL)' ;;
    application/java-archive|application/x-java-archive) extension=jar; type_name='contenedor Java JAR' ;;
    application/vnd.android.package-archive) extension=apk; type_name='paquete Android APK' ;;
    application/epub+zip) extension=epub; type_name='libro EPUB' ;;
    application/vnd.openxmlformats-officedocument.wordprocessingml.document)
        extension=docx; type_name='documento Word DOCX' ;;
    application/vnd.openxmlformats-officedocument.spreadsheetml.sheet)
        extension=xlsx; type_name='hoja de cálculo Excel XLSX' ;;
    application/vnd.openxmlformats-officedocument.presentationml.presentation)
        extension=pptx; type_name='presentación PowerPoint PPTX' ;;
    application/vnd.oasis.opendocument.text) extension=odt; type_name='documento OpenDocument ODT' ;;
    application/vnd.oasis.opendocument.spreadsheet) extension=ods; type_name='hoja OpenDocument ODS' ;;
    application/vnd.oasis.opendocument.presentation) extension=odp; type_name='presentación OpenDocument ODP' ;;
    application/msword) extension=doc; type_name='documento Word DOC' ;;
    application/vnd.ms-excel) extension=xls; type_name='hoja de cálculo Excel XLS' ;;
    application/vnd.ms-powerpoint) extension=ppt; type_name='presentación PowerPoint PPT' ;;
    application/rtf|text/rtf) extension=rtf; type_name='documento RTF' ;;
    application/json|text/json) extension=json; type_name='datos JSON' ;;
    application/xml|text/xml) extension=xml; type_name='documento XML' ;;
    text/html) extension=html; type_name='documento HTML' ;;
    text/x-php|application/x-php|application/x-httpd-php) extension=php; type_name='código PHP' ;;
    text/x-python|text/x-script.python) extension=py; type_name='código Python' ;;
    text/x-shellscript|application/x-shellscript) extension=sh; type_name='script de shell' ;;
    text/javascript|application/javascript) extension=js; type_name='código JavaScript' ;;
    audio/mpeg) extension=mp3; type_name='audio MPEG/MP3' ;;
    audio/wav|audio/x-wav|audio/vnd.wave) extension=wav; type_name='audio WAV' ;;
    audio/flac|audio/x-flac) extension=flac; type_name='audio FLAC' ;;
    audio/ogg|video/ogg|application/ogg) extension=ogg; type_name='contenedor Ogg' ;;
    audio/mp4) extension=m4a; type_name='audio en contenedor MP4' ;;
    video/mp4) extension=mp4; type_name='contenedor MP4' ;;
    video/webm|audio/webm) extension=webm; type_name='contenedor WebM' ;;
    video/x-matroska|audio/x-matroska) extension=mkv; type_name='contenedor Matroska' ;;
    video/x-msvideo) extension=avi; type_name='contenedor AVI' ;;
    video/quicktime) extension=mov; type_name='contenedor QuickTime' ;;
    application/vnd.tcpdump.pcap|application/x-pcap) extension=pcap; type_name='captura de red PCAP' ;;
    application/x-pcapng) extension=pcapng; type_name='captura de red PCAPNG' ;;
esac

# Si libmagic no dio un formato de la lista, compara algunas firmas conocidas.
# Esto también puede reconocer una cabecera de un archivo incompleto o falso:
# se informa explícitamente como coincidencia de firma, sin validar estructura.
if [[ -z "$type_name" ]]; then
    case "$magic_hex" in
        89504e470d0a1a0a*) extension=png; type_name='imagen PNG' ;;
        ffd8ff*) extension=jpg; type_name='imagen JPEG' ;;
        474946383761*|474946383961*) extension=gif; type_name='imagen GIF' ;;
        255044462d*) extension=pdf; type_name='documento PDF' ;;
        504b0304*|504b0506*|504b0708*) extension=zip; type_name='contenedor ZIP; puede contener otro formato' ;;
        377abcaf271c*) extension=7z; type_name='archivo comprimido 7-Zip' ;;
        526172211a0700*|526172211a070100*) extension=rar; type_name='archivo comprimido RAR' ;;
        1f8b08*) extension=gz; type_name='archivo comprimido GZIP' ;;
        fd377a585a00*) extension=xz; type_name='archivo comprimido XZ' ;;
        53514c69746520666f726d6174203300*) extension=sqlite; type_name='base de datos SQLite' ;;
        7f454c46*) extension=elf; type_name='binario ELF' ;;
        52494646????????57454250*) extension=webp; type_name='imagen WebP' ;;
        52494646????????57415645*) extension=wav; type_name='audio WAV' ;;
        52494646????????41564920*) extension=avi; type_name='contenedor AVI' ;;
    esac
    if [[ -n "$type_name" ]]; then
        method='solo firma de cabecera; estructura completa no validada'
    fi
fi

# Aprovecha también las extensiones de la base de libmagic para otros formatos.
if [[ -z "$type_name" ]]; then
    extensions=$(file -b -L --extension -- "$path" 2>/dev/null) || extensions=''
    candidate=${extensions%%/*}
    if [[ "$candidate" =~ ^[A-Za-z0-9][A-Za-z0-9_+-]*$ ]]; then
        extension=$candidate
        type_name=$description
    elif [[ "$mime" == text/plain ]]; then
        type_name='texto plano (sin extensión única)'
    elif [[ "$mime" != application/octet-stream && "$mime" != application/x-empty ]]; then
        # No confundir «no hay extensión conocida» con «no se reconoce nada».
        type_name=$description
    fi
fi

status=0
if [[ -n "$extension" ]]; then
    printf 'El archivo parece ser: .%s (%s)\n' "$extension" "$type_name"
elif [[ -n "$type_name" ]]; then
    printf 'El archivo parece ser: %s\n' "$type_name"
else
    printf 'No se pudo identificar un formato concreto.\n'
    printf 'Descripción de file: %s\n' "$description"
    status=1
fi

if [[ "$method" == 'solo firma'* ]]; then
    printf 'Nota: solo coincide la firma de cabecera; no confirma un archivo válido.\n'
fi
if [[ "$verbose" == true ]]; then
    printf 'MIME: %s\n' "$mime"
    printf 'Descripción de file: %s\n' "$description"
    printf 'Método: %s\n' "$method"
    printf 'Primeros 32 bytes (o los disponibles), en hexadecimal:\n'
    od -An -v -tx1 -N 32 -- "$path" || fail 'No se pudo mostrar la cabecera.'
fi

exit "$status"
